# ============================================
# TopGG Auto Vote - Docker Environment Variables
# ============================================
# Copy this file to docker.env and fill in your values
# DO NOT commit docker.env to version control

# ============================================
# Discord Configuration
# ============================================
# Comma-separated list of Discord tokens (one per account)
# Example: token1,token2,token3
DISCORD_TOKENS=your_discord_token_here

# ============================================
# TopGG Configuration
# ============================================
# OwO Bot ID (default: 408785106942164992)
TOPGG_BOT_ID=408785106942164992

# ============================================
# Scheduling Configuration
# ============================================
# Vote interval in hours (default: 12)
VOTE_INTERVAL_HOURS=12

# Cron expression for scheduling (default: every 12 hours)
CRON_EXPRESSION=0 */12 * * *

# ============================================
# Logging Configuration
# ============================================
# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=info

# Log directory (default: /app/logs)
LOG_DIR=/app/logs

# Log retention period (default: 14 days)
LOG_MAX_FILES=14d

# Maximum log file size before rotation (default: 20m)
LOG_MAX_SIZE=20m

# ============================================
# Browser Configuration
# ============================================
# Headless mode (default: true)
# Set to false for debugging (requires X server)
HEADLESS=true

# Browser timeout in milliseconds (default: 30000)
BROWSER_TIMEOUT=30000

# ============================================
# Captchaly Configuration (Optional)
# ============================================
# Captchaly API key for Turnstile solving
# Leave empty to skip Turnstile auto-solving
CAPTCHALY_API_KEY=

# Captchaly base URL (default: https://api.captchaly.com)
CAPTCHALY_BASE_URL=https://api.captchaly.com

# Captchaly timeout in milliseconds (default: 60000)
CAPTCHALY_TIMEOUT=60000

# ============================================
# Timezone Configuration
# ============================================
# Container timezone (default: UTC)
# Example: America/New_York, Europe/London, Asia/Tokyo
TIMEZONE=UTC

# ============================================
# Environment
# ============================================
# Node environment (default: production)
NODE_ENV=production
